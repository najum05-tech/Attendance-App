################################################################################
# WhatsApp Notification Configuration
# Copy these to your .env file and fill in your actual credentials
################################################################################

# WhatsApp Provider Selection
# Options: twilio, whatsapp_business, generic
WHATSAPP_PROVIDER=twilio

# Twilio Configuration (Required if WHATSAPP_PROVIDER=twilio)
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:

# Optional: Default country code for local phone numbers without country prefix
# Used by PhoneNumberFormatter when a number starts with 0 (e.g., 03001234567 -> +923001234567)
WHATSAPP_DEFAULT_COUNTRY_CODE=92

# WhatsApp Business API Configuration (Required if WHATSAPP_PROVIDER=whatsapp_business)
# Get these from https://developers.facebook.com/apps
# WHATSAPP_BUSINESS_TOKEN=your_access_token_here
# WHATSAPP_BUSINESS_PHONE_ID=your_phone_number_id_here
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Generic HTTP API Configuration (Required if WHATSAPP_PROVIDER=generic)
# For custom WhatsApp API providers
# WHATSAPP_API_URL=https://your-api-provider.com/send
# WHATSAPP_API_KEY=your_api_key_here

################################################################################
# Queue Configuration (Optional but Recommended for Notifications)
# By default, WhatsAppNotification implements ShouldQueue for async delivery
# Run: php artisan queue:work
################################################################################
# QUEUE_CONNECTION=database
# or use redis, sqs, etc. depending on your setup
